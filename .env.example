# ===================================================================
# EmailJS Configuration for Kunal's Portfolio
# ===================================================================
# Obtain these credentials from your EmailJS Dashboard (https://dashboard.emailjs.com)

# 1. EmailJS Service ID (from 'Email Services' tab)
VITE_EMAILJS_SERVICE_ID=your_service_id_here

# 2. EmailJS Owner Notification Template ID (Template 1: Sends message to you)
VITE_EMAILJS_TEMPLATE_ID=your_owner_template_id_here
VITE_EMAILJS_OWNER_TEMPLATE_ID=your_owner_template_id_here

# 3. EmailJS Visitor Auto-Reply Template ID (Template 2: Sends confirmation to visitor)
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=your_autoreply_template_id_here

# 4. EmailJS Public Key / User ID (from 'Account' -> 'Public Key')
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
